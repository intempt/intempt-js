{
  "name": "intemptjs",
  "version": "6.0.0",
  "description": "Intempt JS SDK — event tracking, identity, and DOM-level experience delivery for the browser.",
  "keywords": [
    "intempt",
    "analytics",
    "event-tracking",
    "personalization",
    "experiences",
    "browser",
    "sdk"
  ],
  "homepage": "https://github.com/intempt/intempt-js#readme",
  "bugs": {
    "url": "https://github.com/intempt/intempt-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intempt/intempt-js.git"
  },
  "license": "MIT",
  "author": "Intempt",
  "type": "module",
  "browser": "./dist/intempt.min.js",
  "unpkg": "./dist/intempt.min.js",
  "jsdelivr": "./dist/intempt.min.js",
  "files": [
    "dist",
    "README.md",
    "USAGE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --mode production --minify",
    "build:staging": "tsc && vite build --mode staging --minify false",
    "build:dev": "tsc && vite build --mode development --minify false",
    "test": "cypress run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "cypress run"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/cypress": "^1.1.3",
    "@types/node": "^20.12.5",
    "@types/uuid": "^9.0.8",
    "@types/web": "^0.0.142",
    "@vitest/coverage-v8": "^2.1.9",
    "cypress": "^13.7.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "terser": "^5.44.1",
    "typescript": "^5.4.4",
    "vite": "5.4.6",
    "vitest": "^2.1.9",
    "webpack": "^5.104.1"
  }
}
