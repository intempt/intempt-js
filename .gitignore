# Generated API reference (npm run docs:api)
docs/api-generated/

# Internal programme docs — tracked locally, not in the repo
docs/sdk-hardening/

# Next.js example build output. `next-env.d.ts` is generated by `next dev`/
# `next build` too, and the reference it writes points into .next/ — committing
# it means committing a triple-slash reference to an ignored path, which the
# repo's own eslint rejects. The example type-checks without it.
examples/nextjs/.next/
examples/nextjs/next-env.d.ts
